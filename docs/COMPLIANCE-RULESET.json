markdown
# Prisma Schema (Core Entities)

```prisma
model Student {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  dob             DateTime
  email           String   @unique
  phone           String?
  program         String
  enrollmentDate  DateTime @default(now())
  guardianId      String?
  assessments     Assessment[]
  drivingLedger   DrivingLedger[]
  attendance      Attendance[]
  credentials     Credential[]
}

model Assessment {
  id          String   @id @default(uuid())
  studentId   String
  moduleId    String
  score       Int
  passed      Boolean
  createdAt   DateTime @default(now())
  Student     Student  @relation(fields: [studentId], references: [id])
}

model DrivingLedger {
  id          String   @id @default(uuid())
  studentId   String
  date        DateTime
  minutes     Int
  environment String
  notes       String?
  Student     Student  @relation(fields: [studentId], references: [id])
}

model Attendance {
  id          String   @id @default(uuid())
  studentId   String
  lessonId    String
  minutes     Int
  createdAt   DateTime @default(now())
  Student     Student  @relation(fields: [studentId], references: [id])
}

model Credential {
  id          String   @id @default(uuid())
  studentId   String
  type        String
  issuedAt    DateTime @default(now())
  hash        String
  Student     Student  @relation(fields: [studentId], references: [id])
}
